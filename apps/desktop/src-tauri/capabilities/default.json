{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main Ascurix window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/backend", "sidecar": true, "args": ["serve"] }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
